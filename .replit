modules = ["nodejs-24", "python-base-3.13", "dotnet-10.0", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "dotnet-build"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "legacy-types"

[[workflows.workflow]]
name = "dotnet-build"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "dotnet build artifacts/api-server/dotnet/TutorGuru.Api.csproj --nologo -v:q && dotnet build artifacts/the-tutor-guru/dotnet/TutorGuru.Web.csproj --nologo -v:q"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "legacy-types"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm run typecheck"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 180000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.development]
PAYGATE_APP_ORIGIN = "https://9061e3b4-1d46-429f-b54d-a1f33f64f74b-00-3ixnok1yoozm-8kl1kc73.kirk.replit.dev"
PAYGATE_MODE = "sandbox"
PAYGATE_PUBLIC_SANDBOX = "true"
PAYGATE_RECURRING_ENABLED = "true"
PAYGATE_PUBLIC_SANDBOX_ACCOUNT = "10011064270"

[userenv.production]
ADMIN_BOOTSTRAP_EMAIL = "vucy.ngomane@gmail.com"
