{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cd dotnet && ASPNETCORE_ENVIRONMENT=Development dotnet run --no-launch-profile",
    "build": "dotnet publish dotnet/TutorGuru.Api.csproj -c Release -o dotnet/publish",
    "start": "cd dotnet/publish && dotnet TutorGuru.Api.dll",
    "dev:legacy": "export NODE_ENV=development && pnpm run build:legacy && pnpm run start:legacy",
    "build:legacy": "node ./build.mjs",
    "start:legacy": "node --enable-source-maps ./dist/index.mjs",
    "test:migration": "node tests/architecture-migration.mjs",
    "test:billing": "dotnet run --project tests/dotnet/BillingChecks.csproj --no-launch-profile",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@clerk/express": "^2.1.76",
    "@clerk/shared": "^4.39.0",
    "@google-cloud/storage": "^8.2.0",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "google-auth-library": "^11.1.0",
    "http-proxy-middleware": "^4.2.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "esbuild": "0.28.2",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0"
  }
}
