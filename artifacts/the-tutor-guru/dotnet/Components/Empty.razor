<MudPaper Elevation="0" Class="pa-8 text-center" Style="border:1px dashed #b9ad92">
    <MudIcon Icon="@Icon" Size="Size.Large" Color="Color.Primary" />
    <MudText Typo="Typo.h6" Class="mt-2">@Title</MudText>
    <MudText Typo="Typo.body2">@Text</MudText>
</MudPaper>
@code {
    [Parameter] public string Icon { get; set; } = Icons.Material.Filled.Inbox;
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string Text { get; set; } = "";
}
