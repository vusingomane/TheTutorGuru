@page "/migrate"
@inherits GuruPage

<MudContainer MaxWidth="MaxWidth.ExtraSmall" Class="py-12">
    <MudPaper Class="pa-6" Elevation="0" Style="border:1px solid #ddd3bd">
        <MudText Typo="Typo.h4" Class="mb-2">Link your existing account</MudText>
        <MudText Class="mb-4">Enter the invitation code you received from TheTutorGuru. You must be signed in with a verified email.</MudText>
        @if (_done) { <MudAlert Severity="Severity.Success">Your previous account is linked.</MudAlert> <MudButton Href="/dashboard" Class="mt-3" Variant="Variant.Filled" Color="Color.Primary">Continue</MudButton> }
        else
        {
            @if (_err != null) { <MudAlert Severity="Severity.Error" Class="mb-3">@_err</MudAlert> }
            <MudTextField T="string" @bind-Value="_code" Label="Invitation code" Variant="Variant.Outlined" Disabled="!Ready" />
            <MudButton FullWidth Class="mt-4" Variant="Variant.Filled" Color="Color.Primary" OnClick="Submit" Disabled="_busy || !Ready">Link account</MudButton>
        }
    </MudPaper>
</MudContainer>

@code {
    string _code = ""; string? _err; bool _busy, _done;
    protected override bool NeedProfile => false;
    async Task Submit()
    {
        if (string.IsNullOrWhiteSpace(_code)) { _err = "Enter your invitation code."; return; }
        _busy = true; _err = null;
        try { await Api.Send("/auth/migrate", "POST", new { code = _code.Trim() }); await Api.RefreshProfile(); _done = true; }
        catch (Exception e) { _err = e.Message; }
        _busy = false;
    }
}
