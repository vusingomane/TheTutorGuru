@page "/reset-password"
@inject GuruApi Api
@inject NavigationManager Nav

<MudContainer MaxWidth="MaxWidth.ExtraSmall" Class="py-12">
    <MudPaper Class="pa-6" Elevation="0" Style="border:1px solid #ddd3bd">
        <MudText Typo="Typo.h4" Class="mb-4">Choose a new password</MudText>
        @if (_done) { <MudAlert Severity="Severity.Success">Password updated.</MudAlert> <MudButton Href="/sign-in" Class="mt-4" Variant="Variant.Filled" Color="Color.Primary">Sign in</MudButton> }
        else
        {
            @if (_err != null) { <MudAlert Severity="Severity.Error" Class="mb-3">@_err</MudAlert> }
            <MudTextField T="string" @bind-Value="_pw" Label="New password" InputType="InputType.Password" Variant="Variant.Outlined" HelperText="At least 10 characters, mixed case, a number and a symbol" Class="mb-3" />
            <MudTextField T="string" @bind-Value="_pw2" Label="Confirm password" InputType="InputType.Password" Variant="Variant.Outlined" />
            <MudButton FullWidth Class="mt-4" Variant="Variant.Filled" Color="Color.Primary" OnClick="Submit" Disabled="_busy">Update password</MudButton>
        }
    </MudPaper>
</MudContainer>

@code {
    string _pw = "", _pw2 = ""; string? _err; bool _busy, _done;
    async Task Submit()
    {
        var q = System.Web.HttpUtility.ParseQueryString(new Uri(Nav.Uri).Query);
        var uid = q["userId"]; var tok = q["token"];
        if (string.IsNullOrEmpty(uid) || string.IsNullOrEmpty(tok)) { _err = "This reset link is incomplete. Request a new one."; return; }
        if (_pw.Length < 10) { _err = "Password must be at least 10 characters."; return; }
        if (_pw != _pw2) { _err = "Passwords do not match."; return; }
        _busy = true; _err = null;
        try { await Api.Send("/auth/reset-password", "POST", new { userId = uid, token = tok, password = _pw }); _done = true; }
        catch (Exception e) { _err = e.Message; }
        _busy = false;
    }
}
