@page "/sign-in"
@inject GuruApi Api
@inject NavigationManager Nav
@inject ISnackbar Snack

<MudContainer MaxWidth="MaxWidth.ExtraSmall" Class="py-12">
    <MudPaper Class="pa-6" Elevation="0" Style="border:1px solid #ddd3bd">
        <MudText Typo="Typo.h4" Class="mb-4">Welcome back</MudText>
        @if (_msg != null) { <MudAlert Severity="Severity.Warning" Class="mb-3">@_msg</MudAlert> }
        <MudForm @ref="_form">
            <MudTextField T="string" @bind-Value="_email" Label="Email" InputType="InputType.Email" Required Variant="Variant.Outlined" Class="mb-3" />
            <MudTextField T="string" @bind-Value="_pw" Label="Password" InputType="InputType.Password" Required Variant="Variant.Outlined" OnKeyDown="OnKey" />
        </MudForm>
        <MudButton FullWidth Class="mt-4" Variant="Variant.Filled" Color="Color.Primary" OnClick="Submit" Disabled="_busy">@(_busy ? "Signing in..." : "Sign in")</MudButton>
        <MudStack Row Justify="Justify.SpaceBetween" Class="mt-4">
            <MudLink Href="/forgot-password">Forgot password?</MudLink>
            <MudLink Href="/sign-up">Create account</MudLink>
        </MudStack>
    </MudPaper>
</MudContainer>

@code {
    MudForm? _form; string _email = "", _pw = ""; string? _msg; bool _busy;
    async Task OnKey(KeyboardEventArgs e) { if (e.Key == "Enter") await Submit(); }
    async Task Submit()
    {
        if (string.IsNullOrWhiteSpace(_email) || string.IsNullOrEmpty(_pw)) { _msg = "Enter your email and password."; return; }
        _busy = true; _msg = null;
        try
        {
            await Api.Send("/auth/login", "POST", new { email = _email.Trim(), password = _pw });
            await Api.RefreshProfile();
            Nav.NavigateTo(Api.Profile == null ? "/onboarding" : Api.Role == "admin" ? "/admin" : "/dashboard");
        }
        catch (ApiException e) { _msg = e.Message; }
        catch (Exception e) { _msg = e.Message; }
        _busy = false;
    }
}
