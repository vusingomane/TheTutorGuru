@page "/sign-up"
@inject GuruApi Api

<MudContainer MaxWidth="MaxWidth.ExtraSmall" Class="py-12">
    <MudPaper Class="pa-6" Elevation="0" Style="border:1px solid #ddd3bd">
        <MudText Typo="Typo.h4" Class="mb-4">Create your account</MudText>
        @if (_done != null) { <MudAlert Severity="Severity.Success" Class="mb-3">@_done</MudAlert> }
        else
        {
            @if (_err != null) { <MudAlert Severity="Severity.Error" Class="mb-3">@_err</MudAlert> }
            <MudTextField T="string" @bind-Value="_email" Label="Email" InputType="InputType.Email" Variant="Variant.Outlined" Class="mb-3" />
            <MudTextField T="string" @bind-Value="_pw" Label="Password" InputType="InputType.Password" Variant="Variant.Outlined" HelperText="At least 10 characters, mixed case, a number and a symbol" Class="mb-3" />
            <MudTextField T="string" @bind-Value="_pw2" Label="Confirm password" InputType="InputType.Password" Variant="Variant.Outlined" />
            <MudButton FullWidth Class="mt-4" Variant="Variant.Filled" Color="Color.Primary" OnClick="Submit" Disabled="_busy">Create account</MudButton>
        }
        <MudText Class="mt-4" Typo="Typo.body2">Already registered? <MudLink Href="/sign-in">Sign in</MudLink></MudText>
    </MudPaper>
</MudContainer>

@code {
    string _email = "", _pw = "", _pw2 = ""; string? _err, _done; bool _busy;
    async Task Submit()
    {
        _err = null;
        if (string.IsNullOrWhiteSpace(_email) || !_email.Contains('@')) { _err = "Enter a valid email address."; return; }
        if (_pw.Length < 10) { _err = "Password must be at least 10 characters, with uppercase and lowercase letters, a number, and a symbol."; return; }
        if (_pw != _pw2) { _err = "Passwords do not match."; return; }
        _busy = true;
        try { var r = await Api.Send("/auth/register", "POST", new { email = _email.Trim(), password = _pw }); _done = r.S("message") is { Length: > 0 } m ? m : "Check your email to verify your account before signing in."; }
        catch (Exception e) { _err = e.Message; }
        _busy = false;
    }
}
