@page "/forgot-password"
@inject GuruApi Api

<MudContainer MaxWidth="MaxWidth.ExtraSmall" Class="py-12">
    <MudPaper Class="pa-6" Elevation="0" Style="border:1px solid #ddd3bd">
        <MudText Typo="Typo.h4" Class="mb-4">Reset your password</MudText>
        @if (_done) { <MudAlert Severity="Severity.Success">If an account exists for that email, a reset link has been sent.</MudAlert> }
        else
        {
            @if (_err != null) { <MudAlert Severity="Severity.Error" Class="mb-3">@_err</MudAlert> }
            <MudTextField T="string" @bind-Value="_email" Label="Email" InputType="InputType.Email" Variant="Variant.Outlined" />
            <MudButton FullWidth Class="mt-4" Variant="Variant.Filled" Color="Color.Primary" OnClick="Submit" Disabled="_busy">Send reset link</MudButton>
        }
        <MudLink Href="/sign-in" Class="d-block mt-4">Back to sign in</MudLink>
    </MudPaper>
</MudContainer>

@code {
    string _email = ""; string? _err; bool _busy, _done;
    async Task Submit()
    {
        _err = null; if (string.IsNullOrWhiteSpace(_email)) { _err = "Enter your email."; return; }
        _busy = true;
        try { await Api.Send("/auth/forgot-password", "POST", new { email = _email.Trim() }); _done = true; } catch (Exception e) { _err = e.Message; }
        _busy = false;
    }
}
