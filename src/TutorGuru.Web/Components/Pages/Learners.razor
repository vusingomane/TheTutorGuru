@page "/learners"
@page "/attendance"
@inherits GuruPage

<Frame Title="@(IsTutor ? "Attendance" : "Learners")" Subtitle="@(IsTutor ? "Choose a session and mark who attended." : "Add the learners you pay for.")" Loading="Loading" Error="@LoadError" OnRetry="Reload">
    @if (IsParent)
    {
        <MudPaper Elevation="0" Class="pa-4 mb-4" Style="border:1px solid #ddd3bd">
            <MudGrid>
                <MudItem xs="12" md="4"><MudTextField T="string" @bind-Value="_name" Label="Learner name" Variant="Variant.Outlined" /></MudItem>
                <MudItem xs="6" md="2"><MudSelect T="int" @bind-Value="_grade" Label="Grade" Variant="Variant.Outlined">@foreach (var g in Enumerable.Range(8, 5)) { <MudSelectItem T="int" Value="g">@g</MudSelectItem> }</MudSelect></MudItem>
                <MudItem xs="12" md="4"><MudTextField T="string" @bind-Value="_email" Label="Learner email" InputType="InputType.Email" Variant="Variant.Outlined" /></MudItem>
                <MudItem xs="12" md="2"><MudButton FullWidth Class="mt-2" Variant="Variant.Filled" Color="Color.Primary" OnClick="Add" Disabled="_busy">Add learner</MudButton></MudItem>
            </MudGrid>
        </MudPaper>
    }
    @if (IsTutor)
    {
        <MudSelect T="string" Value="_session" ValueChanged="SelectSession" Label="Session" Variant="Variant.Outlined" Class="mb-4" Disabled="_saving.Count > 0">
            @foreach (var s in _sessions) { <MudSelectItem T="string" Value="@s.S("id")">@s.S("title") - @J.Date(s.S("startsAt"))</MudSelectItem> }
        </MudSelect>
        @if (_sessions.Count == 0) { <MudAlert Severity="Severity.Info" Class="mb-4">No sessions are available. Create a class session first.</MudAlert> }
        @if (_rosterLoading) { <MudProgressLinear Indeterminate Color="Color.Primary" Class="mb-4" /> }
        @if (_rosterError != null) { <MudAlert Severity="Severity.Error" Class="mb-4">@_rosterError <MudButton OnClick="() => SelectSession(_session)">Retry</MudButton></MudAlert> }
    }
    @if (_learners.Count == 0) { <Empty Icon="@Icons.Material.Filled.Groups" Title="No learners yet" Text="@(IsParent ? "Add your first learner above." : "Learners appear once they have an active subscription.")" /> }
    else
    {
        <MudPaper Elevation="0" Style="border:1px solid #ddd3bd">
        <MudList T="string">
        @foreach (var l in _learners)
        {
            var id = l.S("id");
            <MudListItem>
                <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                    <div><MudText Typo="Typo.subtitle1">@l.S("name")</MudText><MudText Typo="Typo.body2">Grade @l.I("grade") &middot; @l.S("email")</MudText></div>
                    @if (IsTutor)
                    {
                        <MudStack Row Spacing="1">
                            <MudButton Size="Size.Small" Variant="@(_att.TryGetValue(id, out var present) && present ? Variant.Filled : Variant.Outlined)" Color="Color.Success" Disabled="@(string.IsNullOrEmpty(_session) || _rosterLoading || _saving.Contains(id))" OnClick="() => Mark(id, true)">Present</MudButton>
                            <MudButton Size="Size.Small" Variant="@(_att.TryGetValue(id, out var absent) && !absent ? Variant.Filled : Variant.Outlined)" Color="Color.Error" Disabled="@(string.IsNullOrEmpty(_session) || _rosterLoading || _saving.Contains(id))" OnClick="() => Mark(id, false)">Absent</MudButton>
                        </MudStack>
                    }
                </MudStack>
            </MudListItem>
        }
        </MudList>
        </MudPaper>
    }
</Frame>

@code {
    List<JsonNode> _learners = new(), _sessions = new(); string _name = "", _email = "", _session = ""; int _grade = 8; bool _busy;
    Dictionary<string, bool> _att = new();
    readonly HashSet<string> _saving = new();
    bool _rosterLoading; string? _rosterError;
    int _rosterVersion;
    protected override async Task Load()
    {
        if (IsTutor)
        {
            _sessions = (await Api.Send("/sessions")).L();
            if (!_sessions.Any(s => s.S("id") == _session)) _session = _sessions.FirstOrDefault().S("id");
            await SelectSession(_session);
        }
        else _learners = (await Api.Send("/learners")).L();
    }
    async Task SelectSession(string session)
    {
        var version = ++_rosterVersion;
        _session = session; _att.Clear(); _learners = new(); _rosterError = null;
        if (string.IsNullOrEmpty(session)) { _rosterLoading = false; return; }
        _rosterLoading = true;
        try
        {
            var rows = (await Api.Send($"/attendance/{Uri.EscapeDataString(session)}")).L();
            if (version != _rosterVersion) return;
            _learners = rows;
            foreach (var learner in rows)
                if (learner["attended"] is not null) _att[learner.S("id")] = learner.B("attended");
        }
        catch (Exception e) { if (version == _rosterVersion) _rosterError = e.Message; }
        finally { if (version == _rosterVersion) _rosterLoading = false; }
    }
    async Task Add()
    {
        if (_name.Trim().Length < 2 || !_email.Contains('@')) { Snack.Add("Enter the learner's name and a valid email.", Severity.Warning); return; }
        _busy = true;
        if (await Run(async () => await Api.Send("/learners", "POST", new { name = _name.Trim(), grade = _grade, email = _email.Trim() }), "Learner added.")) { _name = ""; _email = ""; await Reload(); }
        _busy = false;
    }
    async Task Mark(string learnerId, bool attended)
    {
        var session = _session;
        if (string.IsNullOrEmpty(session) || !_saving.Add(learnerId)) return;
        try
        {
            if (await Run(async () => await Api.Send($"/attendance/{session}/{learnerId}", "PUT", new { attended }), attended ? "Marked present." : "Marked absent.") && _session == session)
                _att[learnerId] = attended;
        }
        finally { _saving.Remove(learnerId); }
    }
}
